{
	"name": "empire",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"typecheck": "bun run --filter '*' typecheck",
		"dev": "concurrently -n \"web,do\" -c \"cyan,magenta\" \"bun run --filter @empire/web dev\" \"bun run --filter @empire/game-room dev\"",
		"dev:do": "bun run --filter @empire/game-room dev",
		"dev:web": "bun run --filter @empire/web dev",
		"build": "bun run --filter @empire/web build",
		"check": "bun run --filter @empire/web check",
		"deploy": "bun run --filter @empire/game-room deploy && bun run --filter @empire/web deploy",
		"deploy:do": "bun run --filter @empire/game-room deploy",
		"deploy:web": "bun run --filter @empire/web deploy",
		"cf-typegen": "bun run --filter @empire/game-room cf-typegen && bun run --filter @empire/web cf-typegen && bun run --filter @empire/database cf-typegen",
		"db:generate": "bun run --filter @empire/database generate",
		"db:migrate:local": "bun run --filter @empire/database migrate:local",
		"db:migrate:remote": "bun run --filter @empire/database migrate:remote"
	},
	"devDependencies": {
		"concurrently": "^10.0.7",
		"typescript": "^6.0.3"
	}
}