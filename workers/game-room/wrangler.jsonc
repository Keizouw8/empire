{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "empire-do",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"d1_databases": [
		{
			"binding": "db",
			"database_name": "d1-empire",
			"database_id": "3dd4e7f4-42ea-470b-a09f-7c6b0447dbd4",
			"migrations_pattern": "./migrations/*/migration.sql",
			"migrations_dir": "./migrations"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "DO",
				"class_name": "GameRoom"
			}
		]
	},
	"exports": {
		"GameRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
