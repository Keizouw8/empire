{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "empire-do",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"durable_objects": {
		"bindings": [
			{
				"name": "DO",
				"class_name": "GameRoom"
			}
		]
	},
	"exports": {
		"GameRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
