{
	"name": "@empire/web-db",
	"private": true,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
		"generate": "drizzle-kit generate",
		"migrate:local": "wrangler d1 migrations apply d1-empire --local  --persist-to ../../.wrangler/state",
		"migrate:remote": "wrangler d1 migrations apply d1-empire --remote"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"drizzle-kit": "^1.0.0-rc.5",
		"typescript": "^6.0.3",
		"wrangler": "^4.151.3"
	},
	"dependencies": {
		"drizzle-orm": "^1.0.0-rc.5",
		"uuidv7": "^1.2.1"
	}
}