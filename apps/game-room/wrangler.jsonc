{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "empire-do",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"vars": {
		"ENVIRONMENT": "production"
	},
	"d1_databases": [
		{
			"binding": "d1",
			"database_name": "empire-d1",
			"database_id": "4bff9f6e-f197-4de7-9058-03c752b42497",
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "do",
				"class_name": "GameRoom"
			}
		]
	},
	"exports": {
		"GameRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
