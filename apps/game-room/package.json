{
	"name": "@empire/game-room",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"cf-typegen": "wrangler types ./src/worker-configuration.d.ts",
