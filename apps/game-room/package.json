		"deploy": "wrangler deploy"
	},
	"dependencies": {
		"@empire/shared": "workspace:*",
		"@empire/web-db": "workspace:*",
		"@empire/game-db": "workspace:*",
		"drizzle-orm": "^1.0.0-rc.5"
	},
	"devDependencies": {
		"wrangler": "^4.151.3"
	}
}
